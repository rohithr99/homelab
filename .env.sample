# =========================================================
# .env for telegram-bot/ — only the variables bot.py itself
# reads. Useful if you want to run/test the bot on its own
# (e.g. `docker compose up` from inside telegram-bot/) rather
# than as part of the full homelab stack.
#
# If you're running the full stack, these same values belong
# in the ROOT .env instead — this file is just a scoped copy
# for standalone use/testing.
# =========================================================

# From @BotFather after you create the bot with /newbot
BOT_TOKEN=123456789:AAExampleTokenFromBotFather

# Address of the local Bot API server container.
# Leave as-is if using the docker-compose setup; only change
# this if you're running the bot-api server elsewhere.
LOCAL_API_URL=http://telegram-bot-api:8081

# Comma-separated Telegram numeric user IDs allowed to use the
# bot (get IDs by messaging @userinfobot). No spaces around commas.
ALLOWED_USER_IDS=111111111,222222222

# Where downloaded files get saved inside the bot's container.
# Should match the volume mount on the jellyfin-bot service.
DOWNLOAD_DIR=/downloads

# Jellyfin's address and API key (Jellyfin -> Dashboard -> API Keys).
# Leave JELLYFIN_URL blank to skip auto-triggering a library scan.
JELLYFIN_URL=http://jellyfin:8096
JELLYFIN_API_KEY=your_jellyfin_api_key_here
