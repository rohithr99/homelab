# =========================================================
# homelab/.env : the file Docker Compose reads.
# Copy this template:  cp .env.sample .env
# Then fill in real values. NEVER commit .env to git.
# Keep comments on their own lines (not after a value).
# =========================================================

# --- Telegram local Bot API server ---
# From https://my.telegram.org -> API development tools
API_ID=
API_HASH=

# --- Telegram bot tokens ---
# From @BotFather (/newbot). One token per bot.
# File saver bot (jellyfin-bot)
BOT_TOKEN=
# YouTube downloader bot (ytdl-bot)
YTDL_BOT_TOKEN=
# Access bot (approves who can use the other bots)
ACCESS_BOT_TOKEN=

# --- Access bot ---
# The access bot's username from BotFather, with the @.
# Shown to people who are refused, so they know where to ask.
ACCESS_BOT_NAME=@your_access_bot_username

# --- Admins ---
# Numeric Telegram IDs (message @userinfobot to get yours).
# Separate several with commas, no spaces: 111111111,222222222
# Admins are always allowed and can approve other people.
ADMIN_IDS=

# --- Jellyfin ---
# Jellyfin Dashboard -> API Keys. Leave empty to skip the
# automatic library refresh after the file bot saves a file.
JELLYFIN_API_KEY=

# --- Pi-hole ---
# Admin password for the Pi-hole web page.
PIHOLE_PASSWORD=

# --- Optional: VPN for qBittorrent through Gluetun ---
# Only needed if you added the gluetun service.
# VPN_PROVIDER=
# WIREGUARD_PRIVATE_KEY=
# WIREGUARD_ADDRESSES=
# VPN_COUNTRY=

